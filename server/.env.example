PORT=4000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
DB_URL=file:local.db

# 32-byte hex string (64 characters) for field-level AES-256-GCM encryption
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 32+ character random secret string for session cookies
SESSION_SECRET=herhealth_dev_session_secret_at_least_32_characters_long_for_security

# Optional AI service configuration
ANTHROPIC_API_KEY=
AI_MODEL=claude-3-5-sonnet-20241022
