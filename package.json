{
  "name": "rechersion-2026",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:server": "npm --workspace=@rechersion/server run dev",
    "build:all": "npm --workspace=@rechersion/server run build && npm run build",
    "test": "npm run test:shared && npm run test:server",
    "test:shared": "npm --workspace=@rechersion/shared test",
    "test:server": "npm --workspace=@rechersion/server test",
    "typecheck": "tsc -b && npm --workspace=@rechersion/shared run typecheck"
  },
  "workspaces": [
    "shared",
    "server"
  ],
  "dependencies": {
    "@rechersion/shared": "*",
    "@tailwindcss/vite": "^4.3.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^3.0.7"
  }
}
